{
  "name": "kubcio-assignment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "auth:generate": "auth generate --config src/lib/auth.ts --output src/db/auth-schema.ts --yes",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test",
    "seed": "bun --env-file=.env.local src/db/seed.ts",
    "test:db": "bun test --env-file=.env.local ./tests-db",
    "test:e2e": "playwright test",
    "test:e2e:watch": "E2E_SLOWMO=2000 playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "E2E_RECORD=1 playwright test || true; playwright show-report"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "better-auth": "^1.7.22",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.22",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
